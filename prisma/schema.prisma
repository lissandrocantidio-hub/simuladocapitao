generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  lastSeenAt   DateTime?
  lastSeenPath String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  purchases    Purchase[]
  accessGrants AccessGrant[]
  simulationAttempts SimulationAttempt[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Purchase {
  id                 String         @id @default(cuid())
  userId             String
  provider           PaymentProvider
  providerPaymentId  String?        @unique
  providerCheckoutId String?        @unique
  providerReference  String?        @unique
  status             PurchaseStatus @default(PENDING)
  amountCents        Int
  currency           String         @default("BRL")
  planCode           String
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AccessGrant {
  id        String            @id @default(cuid())
  userId    String
  planCode  String
  status    AccessGrantStatus @default(ACTIVE)
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model PaymentAccess {
  id                           String   @id @default(cuid())
  email                        String   @unique
  paymentId                    String?  @unique
  status                       String
  accessGranted                Boolean  @default(false)
  confirmationEmailSentAt      DateTime?
  confirmationEmailSentForPaymentId String?
  confirmationEmailLastError   String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model MercadoPagoPayment {
  id          String    @id @default(cuid())
  paymentId   String    @unique
  email       String
  status      String
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("BRL")
  eventId     String    @unique
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
}

model MercadoPagoWebhookEvent {
  id         String   @id @default(cuid())
  topic      String?
  action     String?
  paymentId  String?
  email      String?
  rawPayload Json?
  createdAt  DateTime @default(now())

  @@index([paymentId, createdAt])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percentOff  Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SimulationAttempt {
  id             String   @id @default(cuid())
  userId         String
  presetHref     String
  presetTitle    String
  subjectLabels  String[]
  questionCount  Int
  correctCount   Int
  scoreRatio     Float
  timeLeftSeconds Int
  wrongTopics    String[]
  questionIds     Int[]    @default([])
  answers        Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, presetHref, createdAt])
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum AccessGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}
